# Copia este archivo como .env.local y rellena los valores (nunca subas .env.local a GitHub).
# En Vercel se añaden las mismas variables en Settings > Environment Variables.

# --- Secretas (solo las usa el servidor) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pon-aqui-la-clave-service_role
# Contraseña de la urbanización: sin ella no se puede crear cuenta
CODIGO_URBANIZACION=pon-aqui-la-contraseña-de-la-urbanizacion

# --- Públicas (llegan al móvil; la clave "anon" / "publishable" es pública) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pon-aqui-la-clave-anon
